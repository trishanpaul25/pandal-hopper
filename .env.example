# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Copy this file to .env.local and fill in. These are public identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase project (Project settings > API). Used ONLY as a live-location relay (Realtime Broadcast), no tables needed.
# Also make sure Realtime > Settings > "Allow public access" is on, or broadcast needs a login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
